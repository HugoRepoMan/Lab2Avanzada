        {
          "name": "N5. POST repitiendo el mismo codigo de E1 (409 Conflict)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const baseUrl = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl') || 'http://localhost:8080';",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/api/agentes',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            codigo: 'AGT-SRV-001',",
                  "            nombre: 'SRV-PROD-01',",
                  "            consumoMemoriaMb: 512.75,",
                  "            estado: 'DESCONECTADO',",
                  "            fechaRegistro: '2026-10-20',",
                  "            activo: true",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (res && res.code === 201) {",
                  "        pm.environment.set('agenteId', res.json().id);",
                  "        pm.collectionVariables.set('agenteId', res.json().id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Estructura ErrorResponse 409 Conflict por código duplicado', function () {",
                  "    pm.expect(json.status).to.eql(409);",
                  "    pm.expect(json.message).to.include('AGT-SRV-001');",
                  "    pm.expect(json.path).to.eql('/api/agentes');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
