                  "const expectedId = Number(pm.environment.get('agenteId') || pm.collectionVariables.get('agenteId'));",
                  "pm.test('El ID devuelto coincide con agenteId', function () {",
                  "    pm.expect(json.id).to.eql(expectedId);",
                  "    pm.expect(json.codigo).to.eql('AGT-SRV-001');",
                  "});"
                ],
