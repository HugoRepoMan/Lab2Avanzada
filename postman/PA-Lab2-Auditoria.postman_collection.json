        {
          "name": "E1. Crear agente (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Header Location está presente', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Respuesta contiene id y datos del agente creado', function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.codigo).to.eql('AGT-SRV-001');",
                  "    pm.expect(json.nombre).to.eql('SRV-PROD-01');",
                  "    pm.expect(json.estado).to.eql('EN_MANTENIMIENTO');",
                  "    pm.expect(json.activo).to.be.true;",
                  "    pm.expect(json.creadoEn).to.not.be.null;",
                  "});",
                  "pm.environment.set('agenteId', json.id);",
                  "pm.collectionVariables.set('agenteId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"AGT-SRV-001\",\n  \"nombre\": \"SRV-PROD-01\",\n  \"consumoMemoriaMb\": 512.75,\n  \"estado\": \"EN_MANTENIMIENTO\",\n  \"fechaRegistro\": \"2026-10-20\",\n  \"activo\": true\n}"
            },
